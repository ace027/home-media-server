# Host identity and container user
TZ=America/New_York
PUID=1000
PGID=1000
UMASK=002

# Domain and storage roots
DOMAIN=example.com
DATA_ROOT=/data
APPDATA_ROOT=/opt/appdata

# LAN IP of the media VM; the admin UIs in compose.lan.yaml bind only to it (Phase 2; removed in Phase 3)
LAN_IP=192.168.1.10
# Uncomment to enable the temporary admin UI ports until Phase 3's Traefik exists:
# COMPOSE_FILE=compose.yaml:compose.lan.yaml

# Secrets policy: never put secrets in this file or in .env.
# Put them in secrets/ instead, either as Docker secrets (files mounted at
# /run/secrets/<name>) or as *_FILE environment variables that point at a
# file under secrets/. secrets/ is gitignored except secrets/.gitkeep.

# Host-script overrides (Proxmox host only; used by scripts/host/*.sh).
# Uncomment to size the VM for a smaller host; see docs/runbooks/01-proxmox-host.md
# section 4, "Sizing the VM for the host". Defaults: 8 cores, 20480 MB, local-zfs.
# VM_STORAGE=local-lvm
# VM_CORES=6
# VM_MEMORY=10240
# ISO=local:iso/debian-13.7.0-amd64-netinst.iso

# Phase 2 script overrides (optional)
# QP_4K_RADARR=Ultra-HD
# QP_4K_SONARR=Ultra-HD
# WAIT_TIMEOUT=600
# WATCH_TIMEOUT=1800
