# Host identity and container user
TZ=America/New_York
PUID=1000
PGID=1000
UMASK=002

# Domain and storage roots
DOMAIN=example.com
# Let's Encrypt account email for the wildcard certificate (Phase 3)
ACME_EMAIL=admin@example.com
# ACME directory; keep the staging URL for the first start, then switch to production:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory
# LAN CIDR allowed on the *.int admin routes (include the Twingate connector's IP)
LAN_CIDR=192.168.1.0/24
# Countries allowed on the public routes (ISO codes, comma-separated, for example US,CA; used by the geo-block)
GEO_ALLOWED_COUNTRIES=US
# Email of the Authentik bootstrap admin (akadmin); its password is secrets/authentik_bootstrap_password (Phase 3)
AUTHENTIK_ADMIN_EMAIL=admin@example.com
DATA_ROOT=/data
APPDATA_ROOT=/opt/appdata

# LAN IP of the media VM (25-arr-wire.sh adds it to SABnzbd's host whitelist)
LAN_IP=192.168.1.10

# DNS servers for every container (stacks/_common.yaml). Defaults are public resolvers;
# set your own (for example the LAN DNS servers) if containers need local names.
# DNS_PRIMARY=1.1.1.1
# DNS_SECONDARY=8.8.8.8

# Secrets policy: never put secrets in this file or in .env.
# Put them in secrets/ instead, either as Docker secrets (files mounted at
# /run/secrets/<name>) or as *_FILE environment variables that point at a
# file under secrets/. secrets/ is gitignored except secrets/.gitkeep.

# Host-script overrides (Proxmox host only; used by scripts/host/*.sh).
# Uncomment to size the VM for a smaller host; see docs/runbooks/01-proxmox-host.md
# section 4, "Sizing the VM for the host". Defaults: 8 cores, 20480 MB, local-zfs.
# VM_STORAGE=local-lvm
# VM_CORES=6
# VM_MEMORY=10240
# ISO=local:iso/debian-13.7.0-amd64-netinst.iso

# Phase 2 script overrides (optional)
# QP_4K_RADARR=Ultra-HD
# QP_4K_SONARR=Ultra-HD
# WAIT_TIMEOUT=600
# WATCH_TIMEOUT=1800
